{
  "name": "timeless-blog",
  "description": "Application created by think.js + nuxt.js (monorepo)",
  "version": "2.0.0",
  "author": "Timeless <804093032@qq.com>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Splacesless/blog.git"
  },
  "scripts": {
    "dev:front": "pnpm -F www dev",
    "dev:admin": "pnpm -F admin dev",
    "dev:server": "pnpm -F server dev",
    "build": "pnpm -r --parallel build",
    "build:front": "pnpm -F www build",
    "build:admin": "pnpm -F admin generate",
    "build:server": "pnpm -F server build",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r --parallel typecheck"
  }
}
